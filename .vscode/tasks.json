{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build API",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/dotnet/src/Coffee2Live.App/Coffee2Live.App.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Publish API",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/dotnet/src/Coffee2Live.App/Coffee2Live.App.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Watch API",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/dotnet/src/Coffee2Live.App/Coffee2Live.App.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run API",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/dotnet/src/Coffee2Live.App/Coffee2Live.App.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run Blazor",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/blazor/blazor.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Watch Blazor",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/blazor/blazor.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run All",
            "dependsOn": ["Run API", "Run Blazor"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Watch All",
            "dependsOn": ["Watch API", "Watch Blazor"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Format Backend",
            "type": "shell",
            "command": "dotnet format",
            "options": {
                "cwd": "${workspaceFolder}/dotnet"
            },
            "problemMatcher": []
        },
        {
            "label": "Format Frontend",
            "type": "shell",
            "command": "dotnet format",
            "options": {
                "cwd": "${workspaceFolder}/blazor"
            },
            "problemMatcher": []
        },
        {
            "label": "Format All",
            "dependsOn": ["Format Backend", "Format Frontend"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Build Agent Instructions",
            "type": "shell",
            "command": "npx tsx .build_agent_instructions/build.ts",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}