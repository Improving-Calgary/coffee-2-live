# Top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C# and Razor files
[*.{cs,razor}]
indent_style = space
indent_size = 4
tab_width = 4

# Allman brace style — matches existing codebase
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Prefer file-scoped namespaces (used in Services, Models, Domain)
csharp_style_namespace_declarations = file_scoped:error

# using directives: System.* first, then alphabetical
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Prefer var everywhere
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression-bodied members (used in CoffeeService)
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Null checks
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# Enforced analyzer rules (fail build + dotnet format --verify-no-changes)
dotnet_diagnostic.IDE0005.severity = error  # Remove unused usings
dotnet_diagnostic.IDE0051.severity = error  # Remove unused private members
dotnet_diagnostic.IDE0001.severity = error  # Simplify type names
dotnet_diagnostic.IDE0002.severity = error  # Remove unnecessary qualification
dotnet_diagnostic.IDE0007.severity = error  # Use var instead of explicit type
dotnet_diagnostic.IDE0008.severity = none   # Suppress "use explicit type" — we prefer var

# this. qualification — don't require it
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# JSON and config files
[*.{json,csproj,props,targets}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
